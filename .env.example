# ===== قاعدة البيانات =====
# mysql  : استخدم MySQL / MariaDB (الإعداد الافتراضي في الإنتاج)
# sqlite : استخدم قاعدة مدمجة بدون أي خدمة خارجية (مناسب للتطوير والعرض)
# auto   : جرّب MySQL، وإن فشل الاتصال انتقل تلقائياً إلى SQLite
DB_CLIENT=auto

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sharq_taste

# مسار قاعدة SQLite (يُستخدم عند DB_CLIENT=sqlite أو auto)
SQLITE_PATH=./data/sharq_taste.db

# ===== الإعدادات العامة =====
SECRET_KEY=your-secret-key-change-this-in-production
PORT=3000

# اتركه فارغاً ليتم توليد روابط الـ QR من عنوان الطلب نفسه (مفيد في الاستضافة)
BASE_URL=

# كلمة مرور لوحة التحكم الافتراضية للمطعم الأول (تُستخدم عند أول تهيئة للقاعدة)
DEFAULT_ADMIN_PASSWORD=admin123
